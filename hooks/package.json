{
  "name": "@arco-design/web-react-hooks",
  "private": true,
  "version": "0.0.0",
  "main": "./lib/index.js",
  "module": "./es/index.js",
  "scripts": {
    "build:es": "rimraf ./es && tsc -p tsconfig.json",
    "build:cjs": "rimraf ./lib && tsc -p tsconfig.cjs.json",
    "build:dist": "cd ../ && BUILD_TYPE=hooks ./node_modules/.bin/arco-scripts build:component:dist",
    "generate": "rimraf src-es/* src-lib/* && node ./scripts/generate.js ",
    "build": "yarn generate && yarn build:cjs && yarn build:es"
  },
  "peerDependencies": {
    "react": ">=16",
    "react-dom": ">=16"
  },
  "devDependencies": {},
  "sideEffects": false
}
