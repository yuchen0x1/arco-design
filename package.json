    "prettier": "^2.5.0",
    "pretty-quick": "^3.1.2",
    "react": "^16.13.0",
    "react-dom": "^16.13.0",
    "react-test-renderer": "^16.7.0",
    "rimraf": "^3.0.2",
    "sinon": "^9.0.1",
    "stylelint": "^14.1.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "^24.0.0",
    "svgo": "^2.8.4",
    "typescript": "^4.4.3"
  },
  "dependencies": {
    "@arco-design/color": "^0.4.0",
    "@babel/runtime": "^7.28.4",
    "b-tween": "^0.3.3",
    "b-validate": "^1.4.2",
    "compute-scroll-into-view": "^1.0.17",
    "dayjs": "^1.10.5",
    "lodash": "^4.18.1",
    "number-precision": "^1.3.1",
