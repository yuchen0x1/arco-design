    "jest-canvas-mock": "^2.5.2",
    "less": "^3.12.2",
    "moment": "^2.31.0",
    "moment-timezone": "^0.5.48",
    "npm-run-all": "^4.1.5",
    "nunjucks": "^3.2.4",
    "patch-package": "8.0.1",
    "playwright": "^1.55.1",
    "postcss": "8.5.23",
